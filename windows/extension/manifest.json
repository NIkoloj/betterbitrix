{
  "manifest_version": 3,
  "name": "BetterBitrix Desktop Bridge",
  "version": "0.2.0",
  "description": "Соединяет Windows-панель BetterBitrix с вашей активной сессией Bitrix.",
  "minimum_chrome_version": "111",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://b24.entgld.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BetterBitrix: подключить эту вкладку"
  },
  "content_scripts": [
    {
      "matches": [
        "https://b24.entgld.com/*"
      ],
      "js": [
        "runtime.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "key": ""
}
